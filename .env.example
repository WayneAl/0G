# 0G Compute Router. Create at pc.0g.ai (mainnet) / pc.testnet.0g.ai (testnet):
# Dashboard -> API Keys -> Create. Deposit before the first call or the Router
# answers 402 insufficient_balance.
TESTNET_API_KEY=sk-...
MAINNET_API_KEY=sk-...
# testnet has only qwen2.5-omni; 0gm-1.0-35b-a3b is mainnet-only (NOTES.md §A3)
OG_NETWORK=testnet

# Burner wallets. Never a key that holds anything (spec §6.5).
# Agent A and Agent B MUST be different wallets or the seal chain proves nothing.
AGENT_A_PRIVATE_KEY=0x...
AGENT_A_ADDRESS=0x...
AGENT_A_ID=1
AGENT_B_PRIVATE_KEY=0x...
AGENT_B_SEAL_SIGNER=0x...
AGENT_B_PAYTO=0x...
AGENT_B_ID=2
DEPLOYER_KEY=0x...

# x402. Base Sepolia; the facilitator is free and needs no key.
# Fallback: https://facilitator.payai.network
PAYMENT_NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
AGENT_B_URL=http://localhost:4021/audit
AGENT_B_PRICE='$0.01'

# 0G chain and 0G Storage. Both have working defaults, so leave them unset unless
# a public endpoint is down or you are pointing at your own. OG_RPC_URL is the
# 0G testnet EVM RPC (chain reads, and the Flow.Submit log scan that turns a
# sealHash back into a storage root); OG_INDEXER_URL is the 0G Storage indexer
# whose HTTPS gateway serves the seal bodies. NOTES.md §G.
# Defaults: https://evmrpc-testnet.0g.ai / https://indexer-storage-testnet-turbo.0g.ai
# OG_RPC_URL=
# OG_INDEXER_URL=

# This file is the reference pair's, and it is read by agent-a/ and agent-b/ only.
# `acu` and the MCP server are installed by strangers with no repo: they read
# env > ~/.acu/config.json > built-in default, under the ACU_* names
# (ACU_AGENT_KEY, ACU_AUDITOR_URL, ACU_DIRECTORY_URL, ACU_REGISTRY,
# ACU_LEDGER_PATH, ACU_RPC_URL, ACU_INDEXER_URL, ACU_HOME).

# Filled in by contracts/script/Deploy.s.sol. demo/run.sh needs all four.
REGISTRY_ADDRESS=0x...
STUB_VERIFIER_ADDRESS=0x...
CLEAN_USD=0x...
TRAP_USD=0x...
INJECTION_USD=0x...
