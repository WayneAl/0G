# 0G Compute Router. Create at pc.0g.ai (mainnet) / pc.testnet.0g.ai (testnet):
# Dashboard -> API Keys -> Create. Deposit before the first call or the Router
# answers 402 insufficient_balance.
TESTNET_API_KEY=sk-...
MAINNET_API_KEY=sk-...
# testnet has only qwen2.5-omni; 0gm-1.0-35b-a3b is mainnet-only (NOTES.md §A3)
OG_NETWORK=testnet

# Burner wallets. Never a key that holds anything (spec §6.5).
# Agent A and Agent B MUST be different wallets or the seal chain proves nothing.
AGENT_A_PRIVATE_KEY=0x...
AGENT_A_ADDRESS=0x...
AGENT_A_ID=1
AGENT_B_PRIVATE_KEY=0x...
AGENT_B_SEAL_SIGNER=0x...
AGENT_B_PAYTO=0x...
AGENT_B_ID=2
DEPLOYER_KEY=0x...

# x402. Base Sepolia; the facilitator is free and needs no key.
# Fallback: https://facilitator.payai.network
PAYMENT_NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
AGENT_B_URL=http://localhost:4021/audit
AGENT_B_PRICE='$0.01'

# Filled in by contracts/script/Deploy.s.sol. demo/run.sh needs all four.
REGISTRY_ADDRESS=0x...
STUB_VERIFIER_ADDRESS=0x...
CLEAN_USD=0x...
TRAP_USD=0x...
INJECTION_USD=0x...
