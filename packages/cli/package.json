{
  "name": "@0x402/cli",
  "version": "0.1.2",
  "description": "acu — your agent hires an auditor, verifies the seal, and signs its own. Quote with no key at all; verify any seal offline.",
  "license": "MIT",
  "author": "Wayne Kuo",
  "homepage": "https://wayneal.github.io/0G",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayneAl/0G.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/WayneAl/0G/issues"
  },
  "keywords": [
    "cli",
    "x402",
    "agent",
    "seal",
    "0g"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./underwrite": "./src/commands/underwrite.ts"
  },
  "bin": {
    "acu": "./bin/acu.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "acu": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./underwrite": {
        "types": "./dist/commands/underwrite.d.ts",
        "default": "./dist/commands/underwrite.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE . && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0x402/config": "workspace:*",
    "@0x402/seal": "workspace:*",
    "@0x402/storage": "workspace:*",
    "@0x402/underwriter": "workspace:*",
    "viem": "^2.23.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
