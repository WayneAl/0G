{
  "name": "@acu/og",
  "version": "0.1.0",
  "description": "0G Compute clients for TEE-attested inference \u2014 the Router (verified tier, attestation carried through) and a direct provider client behind one interface.",
  "license": "MIT",
  "author": "Wayne Kuo",
  "homepage": "https://wayneal.github.io/0G",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayneAl/0G.git",
    "directory": "packages/og"
  },
  "bugs": {
    "url": "https://github.com/WayneAl/0G/issues"
  },
  "keywords": [
    "0g",
    "tee",
    "inference",
    "attestation",
    "llm"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE . && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@acu/seal": "workspace:*",
    "viem": "^2.23.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "dotenv": "^16.4.7"
  }
}
