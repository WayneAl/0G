{
  "name": "@0x402/auditor",
  "version": "0.1.0",
  "description": "The Agent B side, as one Express route: an x402-paid audit that answers with a signed seal, plus the free agent card a caller reads before paying.",
  "license": "MIT",
  "author": "Wayne Kuo",
  "homepage": "https://wayneal.github.io/0G",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayneAl/0G.git",
    "directory": "packages/auditor"
  },
  "bugs": {
    "url": "https://github.com/WayneAl/0G/issues"
  },
  "keywords": [
    "x402",
    "express",
    "agent",
    "audit",
    "seal"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE . && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0x402/og": "workspace:*",
    "@0x402/seal": "workspace:*",
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "@x402/express": "^2.24.0",
    "viem": "^2.23.2",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "express": "^4.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "express": "^4.21.2",
    "vitest": "^3.0.5"
  }
}
