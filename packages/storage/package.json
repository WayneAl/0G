{
  "name": "@acu/storage",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./publish": "./src/publish.ts",
    "./locate": "./src/locate.ts",
    "./fetch": "./src/fetch.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./publish": {
        "types": "./dist/publish.d.ts",
        "default": "./dist/publish.js"
      },
      "./locate": {
        "types": "./dist/locate.d.ts",
        "default": "./dist/locate.js"
      },
      "./fetch": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acu/seal": "workspace:*",
    "@acu/underwriter": "workspace:*",
    "@0gfoundation/0g-storage-ts-sdk": "1.2.12",
    "ethers": "6.13.1",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
