{
  "name": "@0x402/storage",
  "version": "0.1.2",
  "description": "Put a seal on the 0G Storage log layer and find it again by its own hash. The root export is isomorphic — no ethers, no SDK — so a browser can do the lookup.",
  "license": "MIT",
  "author": "Wayne Kuo",
  "homepage": "https://wayneal.github.io/0G",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayneAl/0G.git",
    "directory": "packages/storage"
  },
  "bugs": {
    "url": "https://github.com/WayneAl/0G/issues"
  },
  "keywords": [
    "0g",
    "storage",
    "seal",
    "browser"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./publish": "./src/publish.ts",
    "./locate": "./src/locate.ts",
    "./fetch": "./src/fetch.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./publish": {
        "types": "./dist/publish.d.ts",
        "default": "./dist/publish.js"
      },
      "./locate": {
        "types": "./dist/locate.d.ts",
        "default": "./dist/locate.js"
      },
      "./fetch": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE . && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0x402/seal": "workspace:*",
    "@0x402/underwriter": "workspace:*",
    "@0gfoundation/0g-storage-ts-sdk": "1.2.12",
    "ethers": "6.13.1",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
