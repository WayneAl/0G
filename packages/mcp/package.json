{
  "name": "@0x402/mcp",
  "version": "0.1.1",
  "description": "An MCP server that lets your own agent hire an auditor, verify a seal and sign its own \u2014 seven tools, and no environment variables to install.",
  "license": "MIT",
  "author": "Wayne Kuo",
  "homepage": "https://wayneal.github.io/0G",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayneAl/0G.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/WayneAl/0G/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "agent",
    "seal"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "acu-mcp": "./bin/acu-mcp.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "acu-mcp": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE . && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@0x402/config": "workspace:*",
    "@0x402/seal": "workspace:*",
    "@0x402/storage": "workspace:*",
    "@0x402/underwriter": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "viem": "^2.23.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
