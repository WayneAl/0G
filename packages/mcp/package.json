{
  "name": "@acu/mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "acu-mcp": "./bin/acu-mcp.mjs"
  },
  "files": [
    "dist",
    "README.md"
