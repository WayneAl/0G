    "@acu/seal": "workspace:*",
    "@acu/storage": "workspace:*",
    "@acu/underwriter": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "viem": "^2.23.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
